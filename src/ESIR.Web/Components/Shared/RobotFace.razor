<div class="esir" style="font-size: @Size">
    <div class="face face--@Mood" role="img" aria-label="ESIR feels @Mood">
        <div class="screen">
            <div class="face-features">
                <span class="eye l"></span>
                <span class="eye r"></span>
                <span class="mouth"></span>
            </div>
        </div>
        @if (Mood is "happy" or "excited" or "sad")
        {
            <div class="hearts" aria-hidden="true"><span>&hearts;</span><span>&hearts;</span><span>&hearts;</span></div>
        }
        @if (Mood is "sleepy" or "tired")
        {
            <div class="zzz" aria-hidden="true"><span>z</span><span>Z</span></div>
        }
    </div>
    <span class="bubble" role="status"></span>
</div>